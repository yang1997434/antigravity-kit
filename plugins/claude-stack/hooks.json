{
  "gate-log-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.gemini/config/plugins/claude-stack/hooks/gate-log-guard.py\" pre",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
